@@ -0,0 +1,86 @@
+import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
+import { ReactiveFormsModule, FormControl, FormGroup, Validators } from '@angular/forms';
+import { MatButtonModule } from '@angular/material/button';
+import { MatDialogModule } from '@angular/material/dialog';
+import { MatFormFieldModule } from '@angular/material/form-field';
+import { MatInputModule } from '@angular/material/input';
+import { HeroSessionService } from './hero-session.service';
+
+@Component({
+  selector: 'app-hero-session-dialog',
+  standalone: true,
+  imports: [ReactiveFormsModule, MatButtonModule, MatDialogModule, MatFormFieldModule, MatInputModule],
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  template: `
+    <h2 mat-dialog-title>Sessão da API</h2>
+    <mat-dialog-content>
+      <p>Use suas credenciais do API Quickstart. As permissões e o contexto são confirmados pelo servidor.</p>
+      @if (session.projectionBlocked()) {
+        <p role="alert">A resposta do encerramento não foi confirmada. O conteúdo ficará suspenso até verificarmos a sessão.</p>
+      } @else if (!session.active()) {
+        <form id="hero-login" [formGroup]="form" (ngSubmit)="login()">
+          <mat-form-field appearance="outline">
+            <mat-label>Usuário</mat-label>
+            <input matInput formControlName="username" autocomplete="username" required data-testid="session-user" />
+          </mat-form-field>
+          <mat-form-field appearance="outline">
+            <mat-label>Senha</mat-label>
+            <input matInput type="password" formControlName="password" autocomplete="current-password" required data-testid="session-password" />
+          </mat-form-field>
+        </form>
+      } @else {
+        <p data-testid="session-identity"><strong>{{ session.displayName() }}</strong></p>
+        @if (session.context()?.state === 'ready') {
+          <p>Contexto: {{ session.context()?.effectiveContext?.activeTenant?.label || session.context()?.effectiveContext?.activeTenant?.tenantId }}</p>
+        } @else if (session.context()) {
+          <p>Selecione um contexto autorizado para continuar.</p>
+          <div class="context-choices">
+            @for (choice of session.choices(); track choice.choiceRef) {
+              <button mat-stroked-button type="button" [disabled]="session.busy()" (click)="session.select(choice.choiceRef)">{{ choice.label }}</button>
+            } @empty {
+              <p>Nenhum contexto disponível. Consulte o administrador da API.</p>
+            }
+          </div>
+          @if (session.nextChoicesCursor()) {
+            <button mat-button type="button" [disabled]="session.busy()" (click)="session.moreChoices()">Carregar mais contextos</button>
+          }
+        }
+      }
+      @if (session.contextNotice()) { <p role="status">{{ session.contextNotice() }}</p> }
+      @if (session.error()) { <p role="alert" class="error">{{ session.error() }}</p> }
+      @if (session.busy()) { <p role="status">Validando a sessão…</p> }
+    </mat-dialog-content>
+    <mat-dialog-actions align="end">
+      <button mat-button mat-dialog-close>Fechar</button>
+      @if (session.projectionBlocked()) {
+        <button mat-stroked-button type="button" [disabled]="session.busy()" (click)="session.check()">Verificar sessão</button>
+        <button mat-flat-button type="button" [disabled]="session.busy()" (click)="session.logout()">Repetir encerramento</button>
+      } @else if (session.active()) {
+        <button mat-button type="button" [disabled]="session.busy()" (click)="session.check()">Verificar sessão</button>
+        <button mat-stroked-button type="button" [disabled]="session.busy()" (click)="session.logout()">Encerrar sessão</button>
+      } @else {
+        <button mat-flat-button type="submit" form="hero-login" [disabled]="form.invalid || session.busy()" data-testid="session-login">Entrar</button>
+      }
+    </mat-dialog-actions>
+  `,
+  styles: `
+    mat-dialog-content { color: var(--mat-sys-on-surface); }
+    form, .context-choices { display: grid; gap: 12px; }
+    mat-form-field { width: 100%; }
+    .error { color: var(--mat-sys-error); }
+  `,
+})
+export class HeroSessionDialogComponent {
+  readonly session = inject(HeroSessionService);
+  readonly form = new FormGroup({
+    username: new FormControl('', { nonNullable: true, validators: Validators.required }),
+    password: new FormControl('', { nonNullable: true, validators: Validators.required }),
+  });
+
+  async login(): Promise<void> {
+    if (this.form.invalid || this.session.busy()) return;
+    const { username, password } = this.form.getRawValue();
+    this.form.controls.password.reset();
+    await this.session.login(username.trim(), password);
+  }
+}
diff --git a/src/app/core/hero-session.service.ts b/src/app/core/hero-session.service.ts
new file mode 100644
index 0000000..5ddbaf7
--- /dev/null
+++ b/src/app/core/hero-session.service.ts
@@ -0,0 +1,151 @@
+import { HttpClient, HttpErrorResponse } from '@angular/common/http';
+import { Injectable, computed, inject, signal } from '@angular/core';
+import { toSignal } from '@angular/core/rxjs-interop';
+import { EnterpriseRuntimeContextService, type EnterpriseRuntimeContextChoice } from '@praxisui/core';
+import { firstValueFrom } from 'rxjs';
+import { PRAXIS_API_ORIGIN } from './platform.config';
+
+/** SESSION and effective identity belong to the server. No credential is kept in web storage. */
+@Injectable({ providedIn: 'root' })
+export class HeroSessionService {
+  private readonly http = inject(HttpClient);
+  readonly runtime = inject(EnterpriseRuntimeContextService);
+  readonly context = toSignal(this.runtime.contextChanges$, { initialValue: null });
+  readonly active = signal(false);
+  readonly projectionBlocked = signal(false);
+  private readonly contextWasConfirmed = signal(false);
+  readonly corporateProjectionBlocked = computed(() => this.contextWasConfirmed() && this.context()?.state !== 'ready');
+  readonly contextNotice = signal<string | null>(null);
+  readonly busy = signal(false);
+  readonly error = signal<string | null>(null);
+  readonly choices = signal<readonly EnterpriseRuntimeContextChoice[]>([]);
+  readonly nextChoicesCursor = signal<string | null>(null);
+  readonly revision = signal(0);
+  readonly displayName = computed(() => this.context()?.user.displayName
+    || this.context()?.user.userId || (this.projectionBlocked() ? 'Encerramento pendente' : this.active() ? 'Sessão ativa' : 'Visitante'));
+
+  /** An older request cannot revoke the projection established by a newer login/context. */
+  expire(expectedRevision: number): void {
+    if (this.revision() !== expectedRevision) return;
+    this.clearProjection();
+    this.contextWasConfirmed.set(false);
+  }
+
+  async check(): Promise<void> {
+    await this.perform(async () => {
+      try { await firstValueFrom(this.http.get<void>(`${PRAXIS_API_ORIGIN}/auth/session`)); }
+      catch (error) {
+        if (error instanceof HttpErrorResponse && error.status === 401) {
+          this.projectionBlocked.set(false);
+          this.contextWasConfirmed.set(false);
+        }
+        throw error;
+      }
+      this.active.set(true);
+      await this.refreshContext();
+      this.projectionBlocked.set(false);
+    }, true);
+  }
+
+  async login(username: string, password: string): Promise<void> {
+    if (this.projectionBlocked()) return;
+    await this.perform(async () => {
+      this.clearProjection();
+      await firstValueFrom(this.http.post<void>(`${PRAXIS_API_ORIGIN}/auth/login`, { username, password }));
+      // A successful login response alone does not prove the browser accepted its cookie.
+      await firstValueFrom(this.http.get<void>(`${PRAXIS_API_ORIGIN}/auth/session`));
+      this.active.set(true);
+      await this.refreshContext();
+    });
+  }
+
+  async logout(): Promise<void> {
+    await this.perform(async () => {
+      this.clearProjection();
+      this.projectionBlocked.set(true);
+      await firstValueFrom(this.http.post<void>(`${PRAXIS_API_ORIGIN}/auth/logout`, {}));
+      this.projectionBlocked.set(false);
+      this.contextWasConfirmed.set(false);
+    });
+  }
+
+  async select(choiceRef: string): Promise<void> {
+    const current = this.context();
+    if (!this.active() || !current) return;
+    await this.perform(async () => {
+      const selected = await this.runtime.switchContext({ choiceRef, expectedSelectionVersion: current.selectionVersion });
+      this.contextWasConfirmed.set(true);
+      this.contextNotice.set(selected.state === 'ready' ? null : 'Escolha um contexto autorizado para habilitar as personalizações corporativas.');
+      this.revision.update((value) => value + 1);
+      this.choices.set([]);
+      this.nextChoicesCursor.set(null);
+    });
+  }
+
+  private async refreshContext(): Promise<void> {
+    let context = null;
+    try { context = await this.runtime.refresh(); }
+    catch (error) {
+      if (error instanceof HttpErrorResponse && error.status === 401) throw error;
+    }
+    if (!context) {
+      this.contextNotice.set(this.contextWasConfirmed()
+        ? 'O contexto corporativo deixou de estar disponível. Verifique a sessão antes de continuar.'
+        : 'Este host não disponibiliza contexto corporativo. A API continua governando as operações pela sessão; personalizações corporativas estão indisponíveis.');
+      this.choices.set([]);
+      this.nextChoicesCursor.set(null);
+      this.revision.update((value) => value + 1);
+      return;
+    }
+    this.contextWasConfirmed.set(true);
+    this.contextNotice.set(context.state === 'ready' ? null : 'Escolha um contexto autorizado para habilitar as personalizações corporativas.');
+    this.revision.update((value) => value + 1);
+    this.choices.set([]);
+    this.nextChoicesCursor.set(null);
+    if (context.state !== 'ready') await this.appendChoices();
+  }
+
+  async moreChoices(): Promise<void> {
+    if (!this.active() || this.busy() || !this.nextChoicesCursor()) return;
+    this.busy.set(true);
+    this.error.set(null);
+    try { await this.appendChoices(this.nextChoicesCursor()!); }
+    catch { this.error.set('Não foi possível carregar mais contextos. Tente novamente.'); }
+    finally { this.busy.set(false); }
+  }
+
+  private async appendChoices(cursor?: string): Promise<void> {
+    const revision = this.revision();
+    const page = await this.runtime.choices(cursor ? { cursor } : {});
+    if (revision !== this.revision()) return;
+    this.choices.update((items) => [...items, ...page.items.filter((next) => !items.some((prior) => prior.choiceRef === next.choiceRef))]);
+    this.nextChoicesCursor.set(page.nextCursor);
+  }
+
+  private clearProjection(): void {
+    this.active.set(false);
+    this.contextNotice.set(null);
+    this.choices.set([]);
+    this.nextChoicesCursor.set(null);
+    this.runtime.invalidate();
+    this.revision.update((value) => value + 1);
+  }
+
+  private async perform(task: () => Promise<void>, silentAnonymous = false): Promise<void> {
+    if (this.busy()) return;
+    this.busy.set(true);
+    this.error.set(null);
+    try {
+      await task();
+    } catch (error) {
+      this.clearProjection();
+      if (!(silentAnonymous && error instanceof HttpErrorResponse && error.status === 401)) {
+        this.error.set(error instanceof HttpErrorResponse && error.status === 401
+          ? 'Não foi possível validar a sessão. Confira suas credenciais e a permissão de cookies deste site.'
+          : 'Não foi possível confirmar a sessão ou seu contexto. Tente novamente; as operações continuam protegidas pela API.');
+      }
+    } finally {
+      this.busy.set(false);
+    }
+  }
+}
diff --git a/src/app/core/hero-session.spec.ts b/src/app/core/hero-session.spec.ts
new file mode 100644
index 0000000..f3d7bb3
--- /dev/null
+++ b/src/app/core/hero-session.spec.ts
@@ -0,0 +1,204 @@
+import { provideHttpClient, HttpClient, withInterceptors } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { API_URL, ResourceDiscoveryService } from '@praxisui/core';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { heroApiSessionInterceptor } from './hero-api.interceptor';
+import { HeroSessionService } from './hero-session.service';
+import { PRAXIS_API_ORIGIN, PRAXIS_API_TRUSTED_REFERENCE_ORIGINS } from './platform.config';
+
+const url = (path: string) => `${PRAXIS_API_ORIGIN}${path}`;
+const ready = {
+  schemaVersion: 'praxis-enterprise-runtime-context.v1', state: 'ready', selectionVersion: 'v1',
+  user: { userId: 'operator', displayName: 'Operador', resolvedFromServerPrincipal: true },
+  effectiveContext: { contextVersion: 'c1', activeTenant: { tenantId: 'isolated', label: 'Ensaio' },
+    activeOrganizationId: null, environment: 'test', locale: 'pt-BR', timezone: 'UTC',
+    activeProfileId: null, activeModuleKey: null, capabilities: [], authorities: [] },
+  reasonCode: null, resolvedAt: '2026-10-13T00:00:00Z',
+};
+
+describe('Hero server session and trusted HTTP boundary', () => {
+  let http: HttpTestingController;
+  let session: HeroSessionService;
+  beforeEach(() => {
+    TestBed.configureTestingModule({ providers: [
+      provideHttpClient(withInterceptors([heroApiSessionInterceptor])), provideHttpClientTesting(),
+      { provide: API_URL, useValue: { default: { baseUrl: url('/api'), trustedOrigins: PRAXIS_API_TRUSTED_REFERENCE_ORIGINS } } },
+    ] });
+    http = TestBed.inject(HttpTestingController);
+    session = TestBed.inject(HeroSessionService);
+    localStorage.clear();
+  });
+  afterEach(() => { http.verify(); localStorage.clear(); });
+
+  async function finishCheck(context = ready): Promise<void> {
+    http.expectOne(url('/auth/session')).flush(null, { status: 204, statusText: 'No Content' });
+    await Promise.resolve();
+    http.expectOne(url('/api/praxis/runtime/context')).flush(context);
+  }
+
+  it('uses cookie credentials and server context without reading fabricated web-storage tokens', async () => {
+    localStorage.setItem('pax.api.token', 'tactical-token-do-not-send');
+    localStorage.setItem('pax.api.user', 'nick.fury');
+    const pending = session.check();
+    const request = http.expectOne(url('/auth/session'));
+    expect(request.request.withCredentials).toBe(true);
+    expect(request.request.headers.has('Authorization')).toBe(false);
+    expect(request.request.headers.has('X-User-ID')).toBe(false);
+    request.flush(null, { status: 204, statusText: 'No Content' });
+    await Promise.resolve();
+    http.expectOne(url('/api/praxis/runtime/context')).flush(ready);
+    await pending;
+    expect(session.displayName()).toBe('Operador');
+    TestBed.inject(HttpClient).get(url('/api/operations/missao-participantes')).subscribe();
+    const business = http.expectOne(url('/api/operations/missao-participantes'));
+    expect(business.request.headers.get('X-User-ID')).toBe('operator');
+    expect(business.request.headers.get('X-Tenant-ID')).toBe('isolated');
+    expect(business.request.headers.has('Authorization')).toBe(false);
+    business.flush({ data: [] });
+  });
+
+  it('keeps a verified SESSION when the optional corporate provider returns 503, with no fabricated identity', async () => {
+    const pending = session.check();
+    http.expectOne(url('/auth/session')).flush(null, { status: 204, statusText: 'No Content' });
+    await Promise.resolve();
+    http.expectOne(url('/api/praxis/runtime/context')).flush({ code: 'RUNTIME_PROVIDER_UNAVAILABLE' }, { status: 503, statusText: 'Unavailable' });
+    await pending;
+    expect(session.active()).toBe(true);
+    expect(session.context()).toBe(null);
+    expect(session.corporateProjectionBlocked()).toBe(false);
+    expect(session.contextNotice()).toContain('não disponibiliza');
+    TestBed.inject(HttpClient).get(url('/api/operations/missao-participantes'), { headers: {
+      'X-User-ID': 'fake-user', 'X-Tenant-ID': 'demo', 'X-Env': 'local',
+      'If-Match': '"strong"', 'Idempotency-Key': 'preserve-key',
+    } }).subscribe();
+    const business = http.expectOne(url('/api/operations/missao-participantes'));
+    expect(business.request.headers.has('X-User-ID')).toBe(false);
+    expect(business.request.headers.has('X-Tenant-ID')).toBe(false);
+    expect(business.request.headers.has('X-Env')).toBe(false);
+    expect(business.request.headers.get('If-Match')).toBe('"strong"');
+    expect(business.request.headers.get('Idempotency-Key')).toBe('preserve-key');
+    expect(localStorage.length).toBe(0);
+    business.flush({ data: [] });
+  });
+
+  it('retains corporate suspension across consumers remounting after previously confirmed context is lost', async () => {
+    const first = session.check(); await finishCheck(); await first;
+    const next = session.check();
+    http.expectOne(url('/auth/session')).flush(null, { status: 204, statusText: 'No Content' });
+    await Promise.resolve();
+    http.expectOne(url('/api/praxis/runtime/context')).flush(null, { status: 503, statusText: 'Unavailable' });
+    await next;
+    expect(session.active()).toBe(true);
+    expect(session.corporateProjectionBlocked()).toBe(true);
+    expect(TestBed.inject(HeroSessionService).corporateProjectionBlocked()).toBe(true);
+    const retry = session.check(); await finishCheck(); await retry;
+    expect(session.corporateProjectionBlocked()).toBe(false);
+  });
+
+  it('does not discard confirmed-context history after an uncertain check and rejected replacement login', async () => {
+    const first = session.check(); await finishCheck(); await first;
+    const check = session.check();
+    http.expectOne(url('/auth/session')).flush(null, { status: 503, statusText: 'Unavailable' });
+    await check;
+    expect(session.corporateProjectionBlocked()).toBe(true);
+    const rejected = session.login('other', 'wrong');
+    http.expectOne(url('/auth/login')).flush(null, { status: 401, statusText: 'Unauthorized' });
+    await rejected;
+    expect(session.corporateProjectionBlocked()).toBe(true);
+    http.expectNone(url('/auth/session'));
+    const settled = session.check();
+    http.expectOne(url('/auth/session')).flush(null, { status: 401, statusText: 'Unauthorized' });
+    await settled;
+    expect(session.corporateProjectionBlocked()).toBe(false);
+  });
+
+  it('sends neither credential policy nor contextual identity to a different origin', () => {
+    TestBed.inject(HttpClient).get('https://foreign.example/api/operations/missao-participantes').subscribe();
+    const foreign = http.expectOne('https://foreign.example/api/operations/missao-participantes');
+    expect(foreign.request.withCredentials).toBe(false);
+    expect(foreign.request.headers.keys()).toEqual([]);
+    foreign.flush({});
+  });
+
+  it('resolves official backend HATEOAS references through the development proxy', () => {
+    const discovery = TestBed.inject(ResourceDiscoveryService);
+    const resource = '/api/operations/missao-participantes/37';
+    const resolved = discovery.resolveHref(`http://127.0.0.1:8088${resource}`);
+    expect(new URL(resolved, window.location.origin).origin).toBe(window.location.origin);
+    expect(new URL(resolved, window.location.origin).pathname).toBe(resource);
+    expect(discovery.resolveHref(`https://foreign.example${resource}`)).toBe(`https://foreign.example${resource}`);
+  });
+
+  it('does not accept login until the cookie is verified by the server', async () => {
+    const pending = session.login('operator', 'private-password');
+    http.expectOne(url('/auth/login')).flush(null, { status: 204, statusText: 'No Content' });
+    await Promise.resolve();
+    http.expectOne(url('/auth/session')).flush(null, { status: 401, statusText: 'Unauthorized' });
+    await pending;
+    expect(session.active()).toBe(false);
+    expect(session.context()).toBe(null);
+    expect(session.error()).toContain('Não foi possível validar');
+    expect(localStorage.length).toBe(0);
+  });
+
+  it('expires the visual session on a current 401, but ignores an older request after a new session', async () => {
+    const checked = session.check(); await finishCheck(); await checked;
+    const client = TestBed.inject(HttpClient);
+    client.get(url('/api/old')).subscribe({ error: () => undefined });
+    const old = http.expectOne(url('/api/old'));
+    const next = session.check(); await finishCheck(); await next;
+    old.flush(null, { status: 401, statusText: 'Unauthorized' });
+    expect(session.active()).toBe(true);
+    client.get(url('/api/current')).subscribe({ error: () => undefined });
+    http.expectOne(url('/api/current')).flush(null, { status: 401, statusText: 'Unauthorized' });
+    expect(session.active()).toBe(false);
+    expect(session.context()).toBe(null);
+    expect(session.displayName()).toBe('Visitante');
+  });
+
+  it('invalidates projections before logout and keeps the transition busy until revocation finishes', async () => {
+    const checked = session.check(); await finishCheck(); await checked;
+    const pending = session.logout();
+    expect(session.busy()).toBe(true);
+    expect(session.active()).toBe(false);
+    expect(session.context()).toBe(null);
+    http.expectOne(url('/auth/logout')).flush(null, { status: 204, statusText: 'No Content' });
+    await pending;
+    expect(session.busy()).toBe(false);
+    expect(session.active()).toBe(false);
+  });
+
+  it('loads all authorized context pages using the opaque server cursor', async () => {
+    const pending = session.check();
+    await finishCheck({ ...ready, state: 'selection-required', effectiveContext: null } as unknown as typeof ready);
+    await Promise.resolve();
+    (await vi.waitFor(() => http.expectOne((req) => req.url === url('/api/praxis/runtime/context/choices')))).flush({
+      items: [{ choiceRef: 'choice-1', label: 'Primeiro', facets: {} }], nextCursor: 'opaque-next',
+    });
+    await pending;
+    const more = session.moreChoices();
+    const page = http.expectOne((req) => req.url === url('/api/praxis/runtime/context/choices'));
+    expect(page.request.params.get('cursor')).toBe('opaque-next');
+    page.flush({ items: [{ choiceRef: 'choice-2', label: 'Segundo', facets: {} }], nextCursor: null });
+    await more;
+    expect(session.choices().map((choice) => choice.choiceRef)).toEqual(['choice-1', 'choice-2']);
+    expect(session.nextChoicesCursor()).toBe(null);
+  });
+
+  it('blocks projections after an uncertain logout until a protected session check settles it', async () => {
+    const checked = session.check(); await finishCheck(); await checked;
+    const pending = session.logout();
+    http.expectOne(url('/auth/logout')).flush(null, { status: 503, statusText: 'Unavailable' });
+    await pending;
+    expect(session.projectionBlocked()).toBe(true);
+    expect(session.displayName()).toBe('Encerramento pendente');
+    await session.login('other', 'not-sent');
+    http.expectNone(url('/auth/login'));
+    const readback = session.check();
+    http.expectOne(url('/auth/session')).flush(null, { status: 401, statusText: 'Unauthorized' });
+    await readback;
+    expect(session.projectionBlocked()).toBe(false);
+    expect(session.active()).toBe(false);
+  });
+});
