diff --git a/src/app/core/hero-api.interceptor.ts b/src/app/core/hero-api.interceptor.ts
new file mode 100644
index 0000000..60c9731
--- /dev/null
+++ b/src/app/core/hero-api.interceptor.ts
@@ -0,0 +1,37 @@
+import { HttpErrorResponse, type HttpInterceptorFn } from '@angular/common/http';
+import { inject } from '@angular/core';
+import { catchError, throwError } from 'rxjs';
+import { PRAXIS_API_ORIGIN } from './platform.config';
+import { HeroSessionService } from './hero-session.service';
+
+/** Credentials and confirmed context are sent exclusively to the configured host. */
+export const heroApiSessionInterceptor: HttpInterceptorFn = (request, next) => {
+  if (typeof window === 'undefined') return next(request);
+  const url = new URL(request.url, window.location.origin);
+  const trustedOrigin = PRAXIS_API_ORIGIN || window.location.origin;
+  if (url.origin !== trustedOrigin || !/^\/(?:api|schemas|auth)(?:\/|$)/.test(url.pathname)) {
+    return next(request);
+  }
+  const session = inject(HeroSessionService);
+  const revision = session.revision();
+  const isBootstrap = url.pathname.startsWith('/auth/') || url.pathname === '/api/praxis/runtime/context';
+  // Strip caller/demo identity even when enterprise integration is unavailable.
+  // Preserve repeated unrelated headers (ETag, idempotency and CSRF included).
+  const confirmed = session.runtime.headers();
+  let headers = request.headers;
+  for (const name of headers.keys()) {
+    if (['x-tenant-id', 'x-tenant', 'x-user-id', 'x-env', 'x-updated-by',
+      'x-praxis-profile-id', 'x-praxis-context-version'].includes(name.toLowerCase())) {
+      headers = headers.delete(name);
+    }
+  }
+  if (!isBootstrap) {
+    for (const [name, value] of Object.entries(confirmed)) {
+      if (typeof value === 'string') headers = headers.set(name, value);
+    }
+  }
+  return next(request.clone({ headers, withCredentials: true })).pipe(catchError((error: unknown) => {
+    if (error instanceof HttpErrorResponse && error.status === 401 && url.pathname !== '/auth/login') session.expire(revision);
+    return throwError(() => error);
+  }));
+};
