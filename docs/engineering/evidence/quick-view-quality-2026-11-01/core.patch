+  private formatConfiguredSummaryValue(
+    rawValue: unknown,
+    fieldDef?: FieldDefinition,
+  ): string | null {
+    const config =
+      fieldDef?.presentation?.valuePresentation ?? fieldDef?.valuePresentation;
+    if (!config || !['number', 'currency', 'percentage'].includes(config.type)) {
+      return null;
+    }
+    // Masked tokens and arbitrary strings must never be coerced into numeric data.
+    if (
+      (typeof rawValue !== 'number' && typeof rawValue !== 'string') ||
+      String(rawValue).trim() === '' ||
+      !Number.isFinite(Number(rawValue))
+    ) {
+      return null;
+    }
+    const rawField = (fieldDef ?? {}) as Record<string, unknown>;
+    // Field-level monetary metadata predates valuePresentation. Keep its host-owned
+    // defaults instead of replacing an amount's currency with the resolver default.
+    const configuredCurrency = config.type === 'currency'
+      ? {
+          ...config,
+          currency: {
+            ...config.currency,
+            code: config.currency?.code ||
+              String(rawField['currency'] ?? rawField['currencyCode'] ?? 'BRL'),
+            precision: config.currency?.precision ??
+              (typeof rawField['decimalPlaces'] === 'number' ? rawField['decimalPlaces'] : 2),
+          },
+        }
+      : config;
+    const resolved = resolveValuePresentation(configuredCurrency, {
+      valueLocale:
+        typeof rawField['locale'] === 'string' ? rawField['locale'] : null,
+      appLocale:
+        this.runtimeContext?.effectiveContext?.locale ??
+        this.i18n?.getLocale?.() ??
+        'pt-BR',
+    });
+    const precision =
+      resolved.currency?.precision ?? resolved.number?.defaultPrecision ?? 2;
+    // Reuse fraction precision from the canonical digitsInfo format when present.
+    const digits = /^(\d+)\.(\d+)-(\d+)$/.exec(resolved.format ?? '');
+    const format = {
+      kind: config.type === 'percentage' ? 'percent' : config.type,
+      locale: resolved.locale,
+      minimumFractionDigits: digits ? Number(digits[2]) : precision,
+      maximumFractionDigits: digits ? Number(digits[3]) : precision,
+      ...(resolved.currency ? { currency: resolved.currency.code } : {}),
+    };
+    try {
+      return formatCompositionValue(rawValue, format);
+    } catch {
+      // An invalid presentation must leave the original value available to the legacy path.
+      return null;
+    }
+  }
